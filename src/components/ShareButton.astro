---
/*
 * Entry actions — a compact lower-right pair of icon buttons:
 *
 *  ⧉  (permalink)  — one-click copies the canonical /e/<id>/ URL to clipboard
 *  ⤴  (share)     — opens native share sheet on touch devices, or a popover
 *                    on desktop (Share on X · Share on LinkedIn · Download card).
 *
 * The popover is rendered via a portal — on first open the menu DOM is moved
 * to <body> so no `transform: translateY(0)` containing-block ancestor (the
 * card-enter animation leaves one behind) can re-scope position:fixed.
 */
interface Props {
  /** Canonical permalink URL — must be absolute for unfurls to work. */
  url: string;
  /** Page/entry title for the share text. */
  title: string;
  /** Optional message body (tweet text + native-share `text`). */
  text?: string;
  /** Path to the entry's card PNG (e.g. /images/cards/x.png) if available. */
  cardSrc?: string;
}

const { url, title, text, cardSrc } = Astro.props;
const shareText = text ?? title;
---

<div
  class="entry-actions"
  data-share
  data-url={url}
  data-title={title}
  data-text={shareText}
  data-card={cardSrc ?? ''}
>
  <button
    class="entry-actions__btn"
    type="button"
    data-action="permalink"
    aria-label="Copy permalink"
    title="Copy permalink"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.72"/>
      <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.72-1.72"/>
    </svg>
  </button>
  <button
    class="entry-actions__btn"
    type="button"
    data-action="share"
    aria-label="Share"
    title="Share"
    aria-haspopup="menu"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 16V4"/>
      <path d="M8 8l4-4 4 4"/>
      <path d="M5 14v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5"/>
    </svg>
  </button>
  <!-- Menu lives here at SSR; JS moves it to <body> on first open so it
       escapes any transform-containing-block ancestor (the card-enter
       animation leaves transform:translateY(0) on .timeline-row). -->
  <div class="share-menu" role="menu" data-share-menu hidden>
    <a class="share-menu__item" data-menu-action="x" role="menuitem" target="_blank" rel="noopener" href="#">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21.5l-7.55 8.63L23 22h-6.99l-5.47-7.18L4.2 22H.94l8.07-9.22L1 2h7.16l4.94 6.53L18.244 2zm-1.22 18h1.91L7.07 4H5.07l11.954 16z"/></svg>
      <span>Share on X</span>
    </a>
    <a class="share-menu__item" data-menu-action="linkedin" role="menuitem" target="_blank" rel="noopener" href="#">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
      <span>Share on LinkedIn</span>
    </a>
    {cardSrc && (
      <a class="share-menu__item" data-menu-action="download" role="menuitem" href={cardSrc} download>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>
        <span>Download card</span>
      </a>
    )}
  </div>
</div>

<style>
  .entry-actions {
    display: inline-flex;
    gap: 0.15rem;
    margin-left: auto;        /* push to the right within .card__links flex */
    align-self: flex-end;
  }
  .entry-actions__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }
  .entry-actions__btn:hover {
    background: rgba(108, 184, 214, 0.16);
    color: var(--color-navy);
  }
  .entry-actions__btn:active { transform: scale(0.94); }
  .entry-actions__btn.is-success {
    color: var(--color-blue);
    background: rgba(108, 184, 214, 0.18);
  }
  .entry-actions__btn[aria-expanded="true"] {
    background: rgba(108, 184, 214, 0.18);
    color: var(--color-navy);
  }

  /* Tooltip popping after a copy — pure CSS via [data-tooltip]. */
  .entry-actions__btn[data-tooltip] { position: relative; }
  .entry-actions__btn[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.25rem 0.5rem;
    border-radius: 5px;
    white-space: nowrap;
    pointer-events: none;
    z-index: 100;
  }

  /* The menu uses :global so the styles still apply after JS moves it
     to <body>, which puts it outside this component's scoped tree. */
  :global(.share-menu) {
    position: fixed;
    min-width: 200px;
    background: #fff;
    border-radius: 10px;
    border: 1px solid rgba(26, 30, 58, 0.08);
    box-shadow: 0 12px 32px rgba(26, 30, 58, 0.22);
    padding: 0.35rem;
    z-index: 1000;
    display: none;
    flex-direction: column;
    font-family: var(--font-body);
  }
  :global(.share-menu.is-open) { display: flex; }
  :global(.share-menu__item) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.7rem;
    font-size: 0.85rem;
    color: var(--color-text);
    border: 0;
    background: transparent;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
  }
  :global(.share-menu__item:hover) {
    background: rgba(108, 184, 214, 0.16);
    color: var(--color-navy);
  }
  :global(.share-menu__item svg) {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  :global(.share-menu__item:hover svg) { color: var(--color-navy); }
</style>

<script>
  (() => {
    const groups = document.querySelectorAll<HTMLElement>('[data-share]');
    if (!groups.length) return;

    // Touch-only gating for the native share sheet. Chrome/macOS technically
    // supports navigator.share, but the desktop sheet is unreliable — desktop
    // always gets the popover instead.
    const isTouchDevice =
      navigator.maxTouchPoints > 0 ||
      (window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
    const canShareFiles = isTouchDevice && (() => {
      try {
        const f = new File([new Blob()], 'probe.png', { type: 'image/png' });
        return !!(navigator.canShare && navigator.canShare({ files: [f] }));
      } catch {
        return false;
      }
    })();

    // Track which group's menu is currently mounted at body level.
    let openGroup: HTMLElement | null = null;
    let openMenu: HTMLElement | null = null;
    let openButton: HTMLElement | null = null;

    function intentUrls(url: string, text: string) {
      const enc = encodeURIComponent;
      return {
        x: `https://twitter.com/intent/tweet?text=${enc(text)}&url=${enc(url)}`,
        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
      };
    }

    function closeMenu() {
      if (!openMenu || !openGroup || !openButton) return;
      openMenu.classList.remove('is-open');
      openMenu.hidden = true;
      openButton.setAttribute('aria-expanded', 'false');
      // Move the menu back to its original group so re-opens still find it.
      openGroup.appendChild(openMenu);
      openGroup = null;
      openMenu = null;
      openButton = null;
    }

    function positionMenu(button: HTMLElement, menu: HTMLElement) {
      menu.style.visibility = 'hidden';
      menu.classList.add('is-open');
      menu.hidden = false;
      const btnRect = button.getBoundingClientRect();
      const menuRect = menu.getBoundingClientRect();
      const margin = 8;
      let top = btnRect.bottom + margin;
      let left = btnRect.right - menuRect.width;
      if (left < margin) left = margin;
      if (left + menuRect.width > window.innerWidth - margin) {
        left = window.innerWidth - menuRect.width - margin;
      }
      // Flip above when there's no room below.
      if (top + menuRect.height > window.innerHeight - margin) {
        top = btnRect.top - menuRect.height - margin;
        if (top < margin) top = margin;
      }
      menu.style.top = `${top}px`;
      menu.style.left = `${left}px`;
      menu.style.visibility = '';
    }

    function openShareMenu(group: HTMLElement, button: HTMLElement, menu: HTMLElement) {
      // Portal: move menu to <body> so position:fixed escapes any
      // transform-containing-block ancestor (.timeline-row's cardEnter
      // animation leaves transform applied, breaking fixed positioning).
      if (menu.parentElement !== document.body) {
        document.body.appendChild(menu);
      }
      openGroup = group;
      openMenu = menu;
      openButton = button;
      positionMenu(button, menu);
      button.setAttribute('aria-expanded', 'true');
    }

    async function nativeShare(url: string, title: string, text: string, cardSrc: string) {
      try {
        if (cardSrc && canShareFiles) {
          const res = await fetch(cardSrc);
          const blob = await res.blob();
          const file = new File([blob], cardSrc.split('/').pop() || 'card.png', { type: blob.type || 'image/png' });
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ files: [file], url, title, text });
            return true;
          }
        }
        if (navigator.share) {
          await navigator.share({ url, title, text });
          return true;
        }
      } catch (err: any) {
        if (err?.name === 'AbortError') return true;
      }
      return false;
    }

    function tooltip(btn: HTMLElement, message: string, ms = 1400) {
      btn.setAttribute('data-tooltip', message);
      btn.classList.add('is-success');
      setTimeout(() => {
        btn.removeAttribute('data-tooltip');
        btn.classList.remove('is-success');
      }, ms);
    }

    groups.forEach((group) => {
      const url = group.dataset.url || location.href;
      const title = group.dataset.title || document.title;
      const text = group.dataset.text || title;
      const cardSrc = group.dataset.card || '';

      const permalinkBtn = group.querySelector('[data-action="permalink"]') as HTMLElement;
      const shareBtn = group.querySelector('[data-action="share"]') as HTMLElement;
      const menu = group.querySelector('[data-share-menu]') as HTMLElement;

      // Pre-fill the intent anchors.
      const intents = intentUrls(url, text);
      (menu.querySelector('[data-menu-action="x"]') as HTMLAnchorElement).href = intents.x;
      (menu.querySelector('[data-menu-action="linkedin"]') as HTMLAnchorElement).href = intents.linkedin;

      permalinkBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        try {
          await navigator.clipboard.writeText(url);
          tooltip(permalinkBtn, 'Copied!');
        } catch {
          prompt('Copy this link:', url);
        }
      });

      shareBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        // Touch device with file support → native share sheet.
        if (canShareFiles && cardSrc) {
          const ok = await nativeShare(url, title, text, cardSrc);
          if (ok) return;
        }
        // Toggle the popover.
        if (openGroup === group) {
          closeMenu();
          return;
        }
        if (openMenu) closeMenu();
        openShareMenu(group, shareBtn, menu);
      });
    });

    // Click-away to close.
    document.addEventListener('click', (e) => {
      if (!openMenu) return;
      if (openMenu.contains(e.target as Node)) return;
      closeMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
    window.addEventListener('resize', () => {
      if (openMenu && openButton) positionMenu(openButton, openMenu);
    });
    window.addEventListener('scroll', () => {
      if (openMenu && openButton) positionMenu(openButton, openMenu);
    }, { passive: true });
  })();
</script>
