---
interface Award {
  id: string;
  label: string;
  curator: string;
}
interface HeroQuote {
  id: string;
  label: string;
  author: string;
}
interface Props {
  awards?: Award[];
  heroQuotes?: HeroQuote[];
}
const { awards = [], heroQuotes = [] } = Astro.props;
---

<header class="header">
  <div class="header__shimmer"></div>
  {heroQuotes.length > 0 && (
    <ul class="header__quotes" aria-label="Standout pull quotes">
      {heroQuotes.map(q => (
        <li class="header__quote">
          <a class="quote-laurel" href={`#${q.id}`} title={`${q.author}: ${q.label}`}>
            <span class="quote-laurel__leaf quote-laurel__leaf--left" aria-hidden="true">❮</span>
            <span class="quote-laurel__body">
              <span class="quote-laurel__author">{q.author}</span>
              <span class="quote-laurel__label">&ldquo;{q.label}&rdquo;</span>
            </span>
            <span class="quote-laurel__leaf quote-laurel__leaf--right" aria-hidden="true">❯</span>
          </a>
        </li>
      ))}
    </ul>
  )}
  {awards.length > 0 && (
    <ul class="header__awards" aria-label="Curated picks and best-of lists">
      {awards.map(a => (
        <li class="header__award">
          <a class="award-laurel" href={`#${a.id}`} title={`${a.curator}: ${a.label}`}>
            <span class="award-laurel__leaf award-laurel__leaf--left" aria-hidden="true">❮</span>
            <span class="award-laurel__body">
              <span class="award-laurel__curator">{a.curator}</span>
              <span class="award-laurel__label">{a.label}</span>
            </span>
            <span class="award-laurel__leaf award-laurel__leaf--right" aria-hidden="true">❯</span>
          </a>
        </li>
      ))}
    </ul>
  )}
  <div class="header__content">
    <div class="header__pre">How is</div>
    <div class="header__title-wrap">
      <div class="header__echo header__echo--1" aria-hidden="true">INCORRUPTIBLE</div>
      <div class="header__echo header__echo--2" aria-hidden="true">INCORRUPTIBLE</div>
      <h1 class="header__title">INCORRUPTIBLE</h1>
    </div>
    <div class="header__post">going?</div>
    <p class="header__subtitle">
      The new book by <span class="header__author">Eric Ries</span> · May 26, 2026
    </p>
    <div class="header__bestsellers-headline" aria-hidden="true">
      <span class="header__bestsellers-rule"></span>
      <span class="header__bestsellers-headline-text">Instant New York Times Bestseller</span>
      <span class="header__bestsellers-rule"></span>
    </div>
    <ul class="header__bestsellers" aria-label="Bestseller list inclusions">
      <li><a href="#2026-06-04-nyt-bestseller-debut" aria-label="New York Times Bestseller"><img src="/images/lists/nyt.svg" alt="The New York Times" /></a></li>
      <li><a href="#2026-06-03-usa-today-bestseller-list" aria-label="USA Today Best-selling Booklist"><img src="/images/lists/usa-today.svg" alt="USA Today" /></a></li>
      <li><a href="#2026-05-31-lithub-independent-press-bestseller" aria-label="Indie Bestsellers List"><img class="header__bestsellers-img--seal" src="/images/lists/indie-bestsellers.png" alt="ABA Indie Bestsellers List" /></a></li>
      <li><a href="#2026-05-26-amazon-bestseller-startups" aria-label="Amazon Bestseller"><img src="/images/lists/amazon.svg" alt="Amazon" /></a></li>
      <li><a href="#2026-06-01-porchlight-may-2026-double-honor" aria-label="Porchlight Bestseller"><img class="header__bestsellers-img--wordmark" src="/images/lists/porchlight.svg" alt="Porchlight" /></a></li>
    </ul>
  </div>
</header>

<style>
  .header {
    background: var(--color-navy-dark);
    padding: 5rem 1.5rem 2.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .header__shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 20%,
      rgba(108, 184, 214, 0.07) 35%,
      rgba(180, 140, 220, 0.05) 45%,
      rgba(232, 64, 64, 0.04) 55%,
      rgba(108, 184, 214, 0.06) 65%,
      transparent 80%
    );
    background-size: 200% 100%;
    animation: shimmer 7s ease-in-out infinite;
    pointer-events: none;
  }

  .header__content {
    position: relative;
    z-index: 1;
  }

  .header__pre,
  .header__post {
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.45em;
    color: var(--color-blue);
    text-transform: uppercase;
    font-weight: 500;
  }

  .header__pre { margin-bottom: 1rem; }
  .header__post { margin-top: 1rem; }

  .header__title-wrap {
    position: relative;
    display: inline-block;
  }

  .header__echo {
    font-family: var(--font-title);
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    user-select: none;
    color: transparent;
  }

  .header__echo--1 {
    -webkit-text-stroke: 1px rgba(108, 184, 214, 0.1);
    top: 8px;
  }

  .header__echo--2 {
    -webkit-text-stroke: 1px rgba(232, 64, 64, 0.05);
    top: 16px;
  }

  .header__title {
    font-family: var(--font-title);
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--color-white);
    position: relative;
    text-shadow: 0 0 80px rgba(108, 184, 214, 0.12);
  }

  .header__subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-top: 1.75rem;
    letter-spacing: 0.03em;
  }


  .header__author {
    color: var(--color-red);
    font-weight: 700;
  }

  /* Bestseller-list strip — sits below the subtitle as a wide, subtle
     attribution row. Each outlet's badge/wordmark uses its own graphic
     treatment; all are white-tinted at low opacity so the strip reads
     as quiet credentialing against the navy bg, not as a sales pitch. */
  /* James-Clear-style headline: hairline rules flanking the
     "INSTANT BESTSELLER" line so the visual unit reads as a single
     credential band — the logos below are the bestseller status,
     not random press attribution. */
  .header__bestsellers-headline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    max-width: 980px;
    margin: 1rem auto 0.65rem;
  }
  .header__bestsellers-rule {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.22);
    max-width: 340px;
  }
  .header__bestsellers-headline-text {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 500;
    white-space: nowrap;
  }
  .header__bestsellers {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.25rem;
    max-width: 980px;
  }
  .header__bestsellers li { margin: 0; line-height: 0; }
  .header__bestsellers a {
    display: inline-block;
    line-height: 0;
    color: #ffffff;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .header__bestsellers a:hover { opacity: 1; }
  .header__bestsellers img {
    height: 26px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }
  /* The Indie Bestsellers PNG is a multi-color illustrated seal whose
     details get wiped by the white-invert filter. Keep its native colors
     and render it noticeably larger so the wordmark inside reads. */
  .header__bestsellers-img--seal {
    height: 48px !important;
    filter: none !important;
  }
  /* Porchlight's wordmark has finer letterforms than NYT/USAT/Amazon's
     marks — bump the height so it's readable at the same opacity. */
  .header__bestsellers-img--wordmark {
    height: 34px !important;
  }

  /* Clean bottom edge — iridescent gradient border only */
  .header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-blue),
      rgba(180, 140, 220, 0.6),
      var(--color-red),
      rgba(180, 140, 220, 0.6),
      var(--color-blue),
      transparent
    );
  }

  /* ── HERO QUOTES (top-left laurels — symmetric mirror of awards on the right,
     same red leaves, but the LABEL ("of the year/decade") is sized big & bold
     like a movie poster headline) ── */
  .header__quotes {
    position: absolute;
    top: 1.25rem;
    left: 1.5rem;
    z-index: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: flex-start;
  }
  .header__quote { margin: 0; }

  .quote-laurel {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1;
    transition: color 0.18s, transform 0.18s;
  }
  .quote-laurel:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  /* Mirror the award laurel column on the right exactly: stacked author + label,
     1-line nowrap on each, red chevron leaves on either side. Natural width
     stagger comes from differing verbatim label lengths. */
  .quote-laurel__leaf {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: rgba(232, 64, 64, 0.75);
    line-height: 1;
    font-weight: 700;
  }

  .quote-laurel__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    align-items: center;
    text-align: center;
  }

  /* Reversed emphasis vs the awards on the right: the praise itself leads
     (larger, white, prominent), with the attributing name shown small + muted
     below — like a pull quote with byline. */
  .quote-laurel__author {
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
    order: 2;
  }

  .quote-laurel__label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-style: italic;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
    white-space: nowrap;
    order: 1;
  }

  /* ── AWARDS (top-right laurels) ── */
  .header__awards {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    z-index: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: flex-end;
  }
  .header__award { margin: 0; }

  .award-laurel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1;
    transition: color 0.18s, transform 0.18s;
  }
  .award-laurel:hover {
    color: var(--color-blue);
    transform: translateY(-1px);
  }

  .award-laurel__leaf {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: rgba(232, 64, 64, 0.75);
    line-height: 1;
    font-weight: 700;
  }

  .award-laurel__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    align-items: center;
    text-align: center;
  }

  .award-laurel__curator {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    white-space: nowrap;
  }

  .award-laurel__label {
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .header__awards,
    .header__quotes {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem 1rem;
      margin: 0 auto 1.25rem;
      padding: 0 1rem;
      align-items: center;
    }
  }

  /* Mobile (≤640px). Sized so 13-char "INCORRUPTIBLE" + 0.08em
     tracking fits inside an iPhone-portrait viewport (~360px usable)
     without clipping. Desktop (>640px) is unchanged. */
  @media (max-width: 640px) {
    .header {
      padding: 2.5rem 0.75rem 2rem;
    }

    .header__title,
    .header__echo {
      font-size: 1.75rem;
      letter-spacing: 0.08em;
    }

    .header__echo--1 { top: 4px; }
    .header__echo--2 { top: 8px; }

    .header__pre,
    .header__post {
      font-size: 0.72rem;
      letter-spacing: 0.32em;
    }
    .header__pre { margin-bottom: 0.6rem; }
    .header__post { margin-top: 0.6rem; }

    .header__subtitle {
      font-size: 0.82rem;
      margin-top: 1.2rem;
      line-height: 1.5;
    }

    .header__bestsellers-headline {
      gap: 0.55rem;
      margin: 0.8rem auto 0.45rem;
    }
    .header__bestsellers-rule {
      max-width: 50px;
    }
    .header__bestsellers-headline-text {
      font-size: 0.55rem;
      letter-spacing: 0.22em;
      white-space: normal;
    }
    .header__bestsellers {
      gap: 1.1rem;
    }
    .header__bestsellers img {
      height: 18px;
    }
    .header__bestsellers-img--seal {
      height: 34px !important;
    }
    .header__bestsellers-img--wordmark {
      height: 24px !important;
    }
  }
</style>
