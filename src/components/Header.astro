---
interface Award {
  id: string;
  label: string;
  curator: string;
}
interface HeroQuote {
  id: string;
  label: string;
  author: string;
}
interface AmazonRank {
  rank: string;   // e.g. "#1"
  badge: string;  // e.g. "New Release"
  category: string; // e.g. "Business Management"
  url?: string;
}
interface Props {
  awards?: Award[];
  heroQuotes?: HeroQuote[];
  amazonRanks?: AmazonRank[];
}
const { awards = [], heroQuotes = [], amazonRanks = [] } = Astro.props;
---

<header class="header">
  <div class="header__shimmer"></div>
  {heroQuotes.length > 0 && (
    <ul class="header__quotes" aria-label="Standout pull quotes">
      {heroQuotes.map(q => (
        <li class="header__quote">
          <a class="quote-laurel" href={`#${q.id}`} title={`${q.author}: ${q.label}`}>
            <span class="quote-laurel__leaf quote-laurel__leaf--left" aria-hidden="true">❮</span>
            <span class="quote-laurel__body">
              <span class="quote-laurel__author">{q.author}</span>
              <span class="quote-laurel__label">&ldquo;{q.label}&rdquo;</span>
            </span>
            <span class="quote-laurel__leaf quote-laurel__leaf--right" aria-hidden="true">❯</span>
          </a>
        </li>
      ))}
    </ul>
  )}
  {awards.length > 0 && (
    <ul class="header__awards" aria-label="Curated picks and best-of lists">
      {awards.map(a => (
        <li class="header__award">
          <a class="award-laurel" href={`#${a.id}`} title={`${a.curator}: ${a.label}`}>
            <span class="award-laurel__leaf award-laurel__leaf--left" aria-hidden="true">❮</span>
            <span class="award-laurel__body">
              <span class="award-laurel__curator">{a.curator}</span>
              <span class="award-laurel__label">{a.label}</span>
            </span>
            <span class="award-laurel__leaf award-laurel__leaf--right" aria-hidden="true">❯</span>
          </a>
        </li>
      ))}
    </ul>
  )}
  <div class="header__content">
    <div class="header__pre">How is</div>
    <div class="header__title-wrap">
      <div class="header__echo header__echo--1" aria-hidden="true">INCORRUPTIBLE</div>
      <div class="header__echo header__echo--2" aria-hidden="true">INCORRUPTIBLE</div>
      <h1 class="header__title">INCORRUPTIBLE</h1>
    </div>
    <div class="header__post">going?</div>
    <p class="header__subtitle">
      The new book by <span class="header__author">Eric Ries</span> · May 26, 2026
    </p>
    {amazonRanks.length > 0 && (
      <ul class="header__amazon" aria-label="Amazon rankings">
        {amazonRanks.map(r => (
          <li class="header__amazon-item">
            {r.url ? (
              <a class="amazon-rank" href={r.url} target="_blank" rel="noopener">
                <span class="amazon-rank__tag"><span class="amazon-rank__num">{r.rank}</span> {r.badge}</span>
                <span class="amazon-rank__cat">in {r.category}</span>
              </a>
            ) : (
              <span class="amazon-rank">
                <span class="amazon-rank__tag"><span class="amazon-rank__num">{r.rank}</span> {r.badge}</span>
                <span class="amazon-rank__cat">in {r.category}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</header>

<style>
  .header {
    background: var(--color-navy-dark);
    padding: 5rem 1.5rem 4.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .header__shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 20%,
      rgba(108, 184, 214, 0.07) 35%,
      rgba(180, 140, 220, 0.05) 45%,
      rgba(232, 64, 64, 0.04) 55%,
      rgba(108, 184, 214, 0.06) 65%,
      transparent 80%
    );
    background-size: 200% 100%;
    animation: shimmer 7s ease-in-out infinite;
    pointer-events: none;
  }

  .header__content {
    position: relative;
    z-index: 1;
  }

  .header__pre,
  .header__post {
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.45em;
    color: var(--color-blue);
    text-transform: uppercase;
    font-weight: 500;
  }

  .header__pre { margin-bottom: 1rem; }
  .header__post { margin-top: 1rem; }

  .header__title-wrap {
    position: relative;
    display: inline-block;
  }

  .header__echo {
    font-family: var(--font-title);
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    user-select: none;
    color: transparent;
  }

  .header__echo--1 {
    -webkit-text-stroke: 1px rgba(108, 184, 214, 0.1);
    top: 8px;
  }

  .header__echo--2 {
    -webkit-text-stroke: 1px rgba(232, 64, 64, 0.05);
    top: 16px;
  }

  .header__title {
    font-family: var(--font-title);
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--color-white);
    position: relative;
    text-shadow: 0 0 80px rgba(108, 184, 214, 0.12);
  }

  .header__subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-top: 1.75rem;
    letter-spacing: 0.03em;
  }

  /* Amazon rankings strip — subtle row beneath the subtitle. Tags echo
     Amazon's own visual language (orange "best seller" pill + faint label)
     without screaming for attention. */
  .header__amazon {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .header__amazon-item { margin: 0; }
  .amazon-rank {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s, opacity 0.18s;
  }
  .amazon-rank:hover {
    transform: translateY(-1px);
  }
  .amazon-rank__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(180deg, #f08804 0%, #c95a01 100%);
    padding: 0.22rem 0.5rem 0.22rem 0.35rem;
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    white-space: nowrap;
  }
  .amazon-rank__num {
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0;
  }
  .amazon-rank__cat {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    letter-spacing: 0.01em;
  }
  .amazon-rank:hover .amazon-rank__cat {
    color: var(--color-blue);
  }

  @media (max-width: 480px) {
    .header__amazon {
      gap: 0.5rem;
    }
    .amazon-rank__cat {
      font-size: 0.65rem;
    }
  }

  .header__author {
    color: var(--color-red);
    font-weight: 700;
  }

  /* Clean bottom edge — iridescent gradient border only */
  .header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-blue),
      rgba(180, 140, 220, 0.6),
      var(--color-red),
      rgba(180, 140, 220, 0.6),
      var(--color-blue),
      transparent
    );
  }

  /* ── HERO QUOTES (top-left laurels — symmetric mirror of awards on the right,
     same red leaves, but the LABEL ("of the year/decade") is sized big & bold
     like a movie poster headline) ── */
  .header__quotes {
    position: absolute;
    top: 1.25rem;
    left: 1.5rem;
    z-index: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: flex-start;
  }
  .header__quote { margin: 0; }

  .quote-laurel {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1;
    transition: color 0.18s, transform 0.18s;
  }
  .quote-laurel:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  /* Mirror the award laurel column on the right exactly: stacked author + label,
     1-line nowrap on each, red chevron leaves on either side. Natural width
     stagger comes from differing verbatim label lengths. */
  .quote-laurel__leaf {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: rgba(232, 64, 64, 0.75);
    line-height: 1;
    font-weight: 700;
  }

  .quote-laurel__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    align-items: center;
    text-align: center;
  }

  /* Reversed emphasis vs the awards on the right: the praise itself leads
     (larger, white, prominent), with the attributing name shown small + muted
     below — like a pull quote with byline. */
  .quote-laurel__author {
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
    order: 2;
  }

  .quote-laurel__label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-style: italic;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
    white-space: nowrap;
    order: 1;
  }

  /* ── AWARDS (top-right laurels) ── */
  .header__awards {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    z-index: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: flex-end;
  }
  .header__award { margin: 0; }

  .award-laurel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1;
    transition: color 0.18s, transform 0.18s;
  }
  .award-laurel:hover {
    color: var(--color-blue);
    transform: translateY(-1px);
  }

  .award-laurel__leaf {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: rgba(232, 64, 64, 0.75);
    line-height: 1;
    font-weight: 700;
  }

  .award-laurel__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    align-items: center;
    text-align: center;
  }

  .award-laurel__curator {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    white-space: nowrap;
  }

  .award-laurel__label {
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .header__awards,
    .header__quotes {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem 1rem;
      margin: 0 auto 1.25rem;
      padding: 0 1rem;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .header {
      padding: 3rem 1rem 2.5rem;
    }

    .header__title,
    .header__echo {
      font-size: 2.2rem;
      letter-spacing: 0.12em;
    }

    .header__echo--1 { top: 5px; }
    .header__echo--2 { top: 10px; }

    .header__pre,
    .header__post {
      font-size: 0.8rem;
    }
  }
</style>
