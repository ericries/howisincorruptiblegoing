---
// Bestseller-list strip in the James Clear / Atomic Habits pattern:
// a cream band sitting between the navy header and the StatsBar, with
// a muted "INSTANT NEW YORK TIMES BESTSELLER" headline flanked by
// hairline rules and a single row of outlet logos in their NATIVE
// colors below. Native colors because every real outlet asset is
// designed for a light background — forcing them onto navy via a
// white-tint filter produces inconsistent results (white blocks for
// non-transparent backgrounds, black dots for inverted globe icons,
// etc.). Cream lets each logo render as its actual brand mark.

interface Outlet {
  href: string;
  src: string;
  alt: string;
  aria: string;
  cls?: string;
}

const outlets: Outlet[] = [
  { href: '#2026-06-04-nyt-bestseller-debut',                src: '/images/lists/nyt.png',                alt: 'The New York Times',          aria: 'New York Times Bestseller',                  cls: 'wm-nyt' },
  { href: '#2026-06-03-usa-today-bestseller-list',           src: '/images/lists/usa-today.svg',          alt: 'USA Today',                   aria: 'USA Today Best-selling Booklist',            cls: 'wm-usat' },
  { href: '#2026-05-31-lithub-independent-press-bestseller', src: '/images/lists/indie-bestsellers.png',  alt: 'ABA Indie Bestsellers List',  aria: 'American Booksellers Association Indie Bestsellers List', cls: 'wm-indie' },
  { href: '#2026-05-26-amazon-bestseller-startups',          src: '/images/lists/amazon.svg',             alt: 'Amazon',                      aria: 'Amazon Bestseller',                          cls: 'wm-amazon' },
  { href: '#2026-06-01-porchlight-may-2026-double-honor',    src: '/images/lists/porchlight.svg',         alt: 'Porchlight',                  aria: 'Porchlight Bestseller',                      cls: 'wm-porchlight' },
];
---

<section class="bestsellers" aria-label="Bestseller list inclusions">
  <div class="bestsellers__headline" aria-hidden="true">
    <span class="bestsellers__rule"></span>
    <span class="bestsellers__headline-text">Instant New York Times Bestseller</span>
    <span class="bestsellers__rule"></span>
  </div>
  <ul class="bestsellers__row">
    {outlets.map((o) => (
      <li class="bestsellers__item">
        <a href={o.href} class="bestsellers__link" aria-label={o.aria}>
          <img class={`bestsellers__img ${o.cls ?? ''}`} src={o.src} alt={o.alt} />
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Cream band — warm light bg matches the cover backdrop and contrasts
     with the navy header above and the StatsBar's navy below, giving the
     strip its own clear "credentials" zone. */
  .bestsellers {
    background: #f5f1e8;
    padding: 0.55rem 1.5rem 0.55rem;
    border-top: 1px solid rgba(26, 30, 58, 0.05);
    border-bottom: 1px solid rgba(26, 30, 58, 0.05);
  }

  .bestsellers__headline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    max-width: 1100px;
    margin: 0 auto 0.35rem;
  }
  .bestsellers__rule {
    flex: 1;
    height: 1px;
    background: rgba(26, 30, 58, 0.22);
    max-width: 300px;
  }
  .bestsellers__headline-text {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: rgba(26, 30, 58, 0.55);
    white-space: nowrap;
    font-weight: 500;
  }

  .bestsellers__row {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.75rem, 4.5vw, 3.5rem);
    flex-wrap: wrap;
    max-width: 1100px;
  }
  .bestsellers__item { margin: 0; line-height: 0; }
  .bestsellers__link {
    display: inline-block;
    line-height: 0;
    opacity: 0.85;
    transition: opacity 0.2s, transform 0.2s;
  }
  .bestsellers__link:hover {
    opacity: 1;
    transform: translateY(-1px);
  }
  .bestsellers__img {
    width: auto;
    display: block;
  }

  /* Per-outlet sizing — NYT gets the dominant visual weight since
     it's the headline credential ('Instant New York Times Bestseller'),
     other outlets sized down so they support rather than compete. */
  .wm-nyt        { height: 36px; }   /* wide blackletter masthead — dominant */
  .wm-usat       { height: 20px; }
  .wm-indie      { height: 52px; }   /* multi-color illustrated seal — slightly larger so fine type is legible */
  .wm-amazon     { height: 22px; }
  .wm-porchlight { height: 38px; }   /* SVG vector — bumped so fine letterforms read crisply */

  @media (max-width: 640px) {
    .bestsellers {
      padding: 0.45rem 0.75rem 0.45rem;
    }
    .bestsellers__headline {
      gap: 0.55rem;
      margin-bottom: 0.3rem;
    }
    .bestsellers__rule { max-width: 50px; }
    .bestsellers__headline-text {
      font-size: 0.6rem;
      letter-spacing: 0.22em;
      white-space: normal;
      text-align: center;
    }
    .bestsellers__row { gap: 1rem 1.5rem; }
    .wm-nyt        { height: 24px; }
    .wm-usat       { height: 14px; }
    .wm-indie      { height: 38px; }
    .wm-amazon     { height: 16px; }
    .wm-porchlight { height: 26px; }
  }
</style>
