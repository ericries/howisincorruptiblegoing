---
// Bestseller-list strip — a navy band sitting between (or merged with)
// the navy Header, presenting four bestseller-list credentials as
// white-knockout marks with explicit credential captions below.
//
// Navy bg (matching the book's primary color and the Header above)
// unifies the row into a single set of credentials in the book's
// brand color, rather than five competing brand palettes. Knockouts
// are sourced as separate -knockout.{svg,png} assets so the originals
// remain available for any future light-bg use.
//
// Amazon is intentionally NOT on the strip — its #1 New Release /
// #1 Best Seller pills already sit in the StatsBar below.

interface Outlet {
  href: string;
  src: string;
  alt: string;
  aria: string;
  caption: string;
  cls?: string;
}

const outlets: Outlet[] = [
  { href: '#2026-06-04-nyt-bestseller-debut',                src: '/images/lists/nyt-knockout.png',                alt: 'The New York Times',         aria: 'New York Times Bestseller',                                caption: 'Bestseller List',         cls: 'wm-nyt' },
  { href: '#2026-06-03-usa-today-bestseller-list',           src: '/images/lists/usa-today-knockout.svg',          alt: 'USA Today',                  aria: 'USA Today Best-Selling Booklist',                          caption: 'Best-Selling Booklist',   cls: 'wm-usat' },
  { href: '#2026-05-31-lithub-independent-press-bestseller', src: '/images/lists/indie-bestsellers-knockout.png', alt: 'ABA Indie Bestsellers List', aria: 'American Booksellers Association Indie Bestsellers List',  caption: 'Independent Bookstores',  cls: 'wm-indie' },
  { href: '#2026-06-01-porchlight-may-2026-double-honor',    src: '/images/lists/porchlight-knockout.svg',         alt: 'Porchlight',                 aria: 'Porchlight Business Book Bestseller',                      caption: 'Business Bestseller',     cls: 'wm-porchlight' },
];
---

<section class="bestsellers" aria-label="Bestseller list inclusions">
  <div class="bestsellers__headline" aria-hidden="true">
    <span class="bestsellers__rule"></span>
    <span class="bestsellers__headline-text">Instant New York Times Bestseller</span>
    <span class="bestsellers__rule"></span>
  </div>
  <ul class="bestsellers__row">
    {outlets.map((o) => (
      <li class="bestsellers__item">
        <a href={o.href} class="bestsellers__link" aria-label={o.aria}>
          <span class="bestsellers__logo-frame">
            <img class={`bestsellers__img ${o.cls ?? ''}`} src={o.src} alt={o.alt} />
          </span>
          <span class="bestsellers__caption">{o.caption}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Navy band — matches the Header above and the book's primary brand
     color, so the credentials feel like they belong to Incorruptible
     rather than to five separate outlets. */
  .bestsellers {
    background: var(--color-navy-dark);
    padding: 0.4rem 1.5rem 0.7rem;
    position: relative;
  }
  /* Iridescent gradient rule at the bottom of the masthead block
     (Header + this strip) — moved here from Header so it appears once,
     after the credentials, rather than mid-block. */
  .bestsellers::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-blue),
      rgba(180, 140, 220, 0.6),
      var(--color-red),
      rgba(180, 140, 220, 0.6),
      var(--color-blue),
      transparent
    );
  }

  .bestsellers__headline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    max-width: 1100px;
    margin: 0 auto 0.5rem;
  }
  .bestsellers__rule {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.22);
    max-width: 300px;
  }
  .bestsellers__headline-text {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
    font-weight: 500;
  }

  .bestsellers__row {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(1.75rem, 5vw, 4rem);
    flex-wrap: wrap;
    max-width: 1100px;
  }
  .bestsellers__item { margin: 0; }
  .bestsellers__link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    opacity: 0.95;
    transition: opacity 0.2s, transform 0.2s;
  }
  .bestsellers__link:hover {
    opacity: 1;
    transform: translateY(-1px);
  }
  /* Fixed logo-zone height so the captions sit on a shared baseline
     regardless of each mark's intrinsic aspect ratio. */
  .bestsellers__logo-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
  }
  .bestsellers__img {
    width: auto;
    display: block;
  }
  /* Caption: small, uppercase, dim white — matches the headline rule's
     vocabulary so the whole strip reads as one typographic system. */
  .bestsellers__caption {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 600;
    white-space: nowrap;
    text-align: center;
    line-height: 1;
  }

  /* Per-outlet sizing — each mark sized for visual balance within the
     fixed 44px logo frame. */
  .wm-nyt        { height: 36px; }   /* wide blackletter masthead */
  .wm-usat       { height: 22px; }
  .wm-indie      { height: 44px; }   /* round seal — fills the frame */
  .wm-porchlight { height: 38px; }

  @media (max-width: 640px) {
    .bestsellers {
      padding: 0.3rem 0.5rem 0.55rem;
    }
    .bestsellers__headline {
      gap: 0.55rem;
      margin-bottom: 0.35rem;
    }
    .bestsellers__rule { max-width: 50px; }
    .bestsellers__headline-text {
      font-size: 0.6rem;
      letter-spacing: 0.22em;
      white-space: normal;
      text-align: center;
    }
    .bestsellers__row { gap: 0.75rem 1.25rem; }
    .bestsellers__link { gap: 0.35rem; }
    .bestsellers__logo-frame { height: 30px; }
    .bestsellers__caption {
      font-size: 0.5rem;
      letter-spacing: 0.14em;
    }
    .wm-nyt        { height: 24px; }
    .wm-usat       { height: 14px; }
    .wm-indie      { height: 30px; }
    .wm-porchlight { height: 24px; }
  }
</style>
