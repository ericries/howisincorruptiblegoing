---
interface AmazonRank {
  rank: string;
  badge: string;
  category: string;
  /** Anchor link to the milestone entry that documents this ranking (preferred). */
  entryId?: string;
  /** Legacy direct-to-Amazon link (kept for back-compat). */
  url?: string;
}
interface Props {
  totalEntries: number;
  totalEndorsements: number;
  amazonRanks?: AmazonRank[];
}

const { totalEntries, totalEndorsements, amazonRanks = [] } = Astro.props;

const LAUNCH_DATE = new Date('2026-05-26T00:00:00Z');
const now = new Date();
const msPerDay = 1000 * 60 * 60 * 24;
const daysToLaunch = Math.max(0, Math.ceil((LAUNCH_DATE.getTime() - now.getTime()) / msPerDay));
const isPostLaunch = now.getTime() >= LAUNCH_DATE.getTime();

// Split rankings evenly across the two flanks. First half → left, second
// half → right. Each side renders its ranks as a vertical stack of pills.
const half = Math.ceil(amazonRanks.length / 2);
const leftRanks = amazonRanks.slice(0, half);
const rightRanks = amazonRanks.slice(half);
---

<div class="stats">
  <div class="stats__inner">
    {leftRanks.length > 0 && (
      <div class="stats__amazon-col stats__amazon-col--left">
        <span class="stats__amazon-header">On Amazon</span>
        <div class="stats__amazon-stack stats__amazon-stack--left">
          {leftRanks.map((r) => (
            <a class="stats__amazon stats__amazon--left" href={r.entryId ? `#${r.entryId}` : r.url} aria-label={`Amazon ${r.rank} ${r.badge} in ${r.category}`}>
              <span class="stats__amazon-pill"><span class="stats__amazon-num">{r.rank}</span> {r.badge}</span>
              <span class="stats__amazon-cat">in {r.category}</span>
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="stats__center">
      <div class="stats__item">
        {isPostLaunch ? (
          <>
            <span class="stats__out-now">OUT NOW</span>
            <span class="stats__label">the book</span>
          </>
        ) : (
          <>
            <span class="stats__number stats__number--red">{daysToLaunch}</span>
            <span class="stats__label">days to launch</span>
          </>
        )}
      </div>
      <div class="stats__divider"></div>
      <div class="stats__item">
        <span class="stats__number stats__number--white">{totalEntries}</span>
        <span class="stats__label">moments</span>
      </div>
      <div class="stats__divider"></div>
      <div class="stats__item">
        <span class="stats__number stats__number--blue">{totalEndorsements}</span>
        <span class="stats__label">voices</span>
      </div>
    </div>
    {rightRanks.length > 0 && (
      <div class="stats__amazon-col stats__amazon-col--right">
        <span class="stats__amazon-header">On Amazon</span>
        <div class="stats__amazon-stack stats__amazon-stack--right">
          {rightRanks.map((r) => (
            <a class="stats__amazon stats__amazon--right" href={r.entryId ? `#${r.entryId}` : r.url} aria-label={`Amazon ${r.rank} ${r.badge} in ${r.category}`}>
              <span class="stats__amazon-pill"><span class="stats__amazon-num">{r.rank}</span> {r.badge}</span>
              <span class="stats__amazon-cat">in {r.category}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .stats {
    background: var(--color-navy);
    padding: 1.5rem 1.5rem;
  }

  .stats__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .stats__center {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    flex: 1;
  }
  /* Each flank: a small "On Amazon" header above the row of ranking pills. */
  .stats__amazon-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    flex-shrink: 0;
  }
  .stats__amazon-col--right {
    align-items: flex-end;
  }
  .stats__amazon-header {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    padding: 0 2px;
  }
  /* Two Amazon ranking pills sit side-by-side on each flank. */
  .stats__amazon-stack {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 0.85rem;
    flex-shrink: 0;
  }
  .stats__amazon-stack--right {
    align-items: flex-end;
  }
  /* Each ranking = a chunky Amazon-style "#1 Best Seller" pill with the
     category text below it. */
  .stats__amazon {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    opacity: 0.95;
    transition: opacity 0.18s, transform 0.18s;
  }
  .stats__amazon:hover {
    opacity: 1;
    transform: translateY(-1px);
  }
  .stats__amazon--right {
    align-items: flex-end;
    text-align: right;
  }
  /* Mimics Amazon's native "#1 Best Seller" badge — chunky burnt-orange
     pill with rounded corners and bold white text. */
  .stats__amazon-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #fff;
    background: #c45500;
    padding: 0.28rem 0.62rem 0.3rem;
    border-radius: 5px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.18), inset 0 -1px 0 rgba(0, 0, 0, 0.15);
    white-space: nowrap;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.18);
  }
  .stats__amazon-num {
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0;
  }
  .stats__amazon-cat {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stats__number {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
  }

  .stats__number--red { color: var(--color-red); }
  .stats__number--blue { color: var(--color-blue); }
  .stats__number--white { color: var(--color-white); }

  /* Post-launch "OUT NOW" replaces the days-to-launch counter. Sized to
     sit at the same baseline as the other stat numbers, with letter-spacing
     to match the marquee feel. */
  .stats__out-now {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-red);
    letter-spacing: 0.04em;
  }

  .stats__label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }

  .stats__divider {
    width: 1px;
    height: 36px;
    background: rgba(108, 184, 214, 0.12);
  }

  @media (max-width: 768px) {
    .stats__amazon-col { display: none; }
    .stats__inner { justify-content: center; }
  }

  /* Mobile (≤640px). Tighten gap and shrink number/label so that the
     three stat blocks (OUT NOW/DAYS / MOMENTS / VOICES) fit inside an
     iPhone-portrait viewport without clipping "VOICES". Amazon flank
     pills hide entirely. */
  @media (max-width: 640px) {
    .stats { padding: 1.25rem 0.75rem; }
    .stats__center { gap: 0.9rem; }
    .stats__divider { height: 28px; }
    .stats__number { font-size: 1.45rem; }
    .stats__out-now { font-size: 1.05rem; }
    .stats__label {
      font-size: 0.55rem;
      letter-spacing: 0.1em;
    }
  }
</style>
