---
interface AmazonRank {
  rank: string;
  badge: string;
  category: string;
  url?: string;
}
interface Props {
  totalEntries: number;
  totalEndorsements: number;
  amazonRanks?: AmazonRank[];
}

const { totalEntries, totalEndorsements, amazonRanks = [] } = Astro.props;

const LAUNCH_DATE = new Date('2026-05-26T00:00:00Z');
const now = new Date();
const daysToLaunch = Math.max(
  0,
  Math.ceil((LAUNCH_DATE.getTime() - now.getTime()) / (1000 * 60 * 60 * 24))
);

// Split the rankings to the two flanks of the stats row (first → left, second → right).
const leftRank = amazonRanks[0] ?? null;
const rightRank = amazonRanks[1] ?? null;
---

<div class="stats">
  <div class="stats__inner">
    {leftRank && (
      <a class="stats__amazon stats__amazon--left" href={leftRank.url} target="_blank" rel="noopener" aria-label={`Amazon ${leftRank.rank} ${leftRank.badge} in ${leftRank.category}`}>
        <span class="stats__amazon-pill"><span class="stats__amazon-num">{leftRank.rank}</span> {leftRank.badge}</span>
        <span class="stats__amazon-cat">in {leftRank.category}</span>
      </a>
    )}
    <div class="stats__center">
      <div class="stats__item">
        <span class="stats__number stats__number--red">{daysToLaunch}</span>
        <span class="stats__label">days to launch</span>
      </div>
      <div class="stats__divider"></div>
      <div class="stats__item">
        <span class="stats__number stats__number--white">{totalEntries}</span>
        <span class="stats__label">moments</span>
      </div>
      <div class="stats__divider"></div>
      <div class="stats__item">
        <span class="stats__number stats__number--blue">{totalEndorsements}</span>
        <span class="stats__label">voices</span>
      </div>
    </div>
    {rightRank && (
      <a class="stats__amazon stats__amazon--right" href={rightRank.url} target="_blank" rel="noopener" aria-label={`Amazon ${rightRank.rank} ${rightRank.badge} in ${rightRank.category}`}>
        <span class="stats__amazon-pill"><span class="stats__amazon-num">{rightRank.rank}</span> {rightRank.badge}</span>
        <span class="stats__amazon-cat">in {rightRank.category}</span>
      </a>
    )}
  </div>
</div>

<style>
  .stats {
    background: var(--color-navy);
    padding: 1.5rem 1.5rem;
  }

  .stats__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .stats__center {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    flex: 1;
  }
  /* Amazon ranking flanks — small, muted, side-anchored. Pushed all the way
     to the edge of the stats row so they don't compete with the headline
     counters in the middle. */
  .stats__amazon {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    opacity: 0.78;
    transition: opacity 0.18s, transform 0.18s;
  }
  .stats__amazon:hover {
    opacity: 1;
    transform: translateY(-1px);
  }
  .stats__amazon--right {
    align-items: flex-end;
    text-align: right;
  }
  .stats__amazon-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(180deg, #f08804 0%, #c95a01 100%);
    padding: 0.18rem 0.42rem 0.18rem 0.32rem;
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    white-space: nowrap;
  }
  .stats__amazon-num {
    font-weight: 800;
    font-size: 0.62rem;
    letter-spacing: 0;
  }
  .stats__amazon-cat {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stats__number {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
  }

  .stats__number--red { color: var(--color-red); }
  .stats__number--blue { color: var(--color-blue); }
  .stats__number--white { color: var(--color-white); }

  .stats__label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }

  .stats__divider {
    width: 1px;
    height: 36px;
    background: rgba(108, 184, 214, 0.12);
  }

  @media (max-width: 768px) {
    .stats__amazon { display: none; }
    .stats__inner { justify-content: center; }
  }

  @media (max-width: 640px) {
    .stats__center { gap: 1.5rem; }
    .stats__number { font-size: 1.8rem; }
  }
</style>
