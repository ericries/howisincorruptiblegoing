---
import type { TimelineEntry } from '../lib/schema';

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;

const today = new Date().toISOString().slice(0, 10);

interface Stop {
  id: string;
  title: string;
  date: string;
  dateLabel: string;
  city: string | null;
  signupUrl: string | null;
}

const upcoming: Stop[] = entries
  .filter((e) => (e.type === 'event' || e.type === 'podcast') && e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3)
  .map((e) => {
    const meta = (e.type_metadata ?? {}) as Record<string, unknown>;
    const city = typeof meta.city === 'string' ? meta.city : null;
    const signupUrl = typeof meta.signup_url === 'string' ? meta.signup_url : null;
    const dateObj = new Date(e.date + 'T00:00:00Z');
    const dateLabel = dateObj.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC',
    });
    return { id: e.id, title: e.title, date: e.date, dateLabel, city, signupUrl };
  });

if (upcoming.length === 0) return;
---

<section class="upcoming" aria-label="Upcoming book-tour stops">
  <div class="upcoming__inner">
    <div class="upcoming__heading-col">
      <h2 class="upcoming__heading">Coming up</h2>
      <p class="upcoming__sub">Book tour stops &amp; podcast drops</p>
    </div>
    <ul class="upcoming__list">
      {upcoming.map((stop) => (
        <li class="upcoming__item">
          <a
            class="upcoming__link"
            href={stop.signupUrl ?? `#${stop.id}`}
            {...(stop.signupUrl ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <div class="upcoming__date">{stop.dateLabel}</div>
            <div class="upcoming__title">{stop.title}</div>
            <div class="upcoming__meta">
              {stop.city ? <span>{stop.city}</span> : <span>Virtual</span>}
              {stop.signupUrl && <span class="upcoming__rsvp">RSVP ↗</span>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .upcoming {
    background: linear-gradient(to bottom, var(--color-gray-bg) 0%, #fff 100%);
    padding: 1.25rem 1.5rem 1.5rem;
    border-top: 1px solid rgba(26, 30, 58, 0.06);
    border-bottom: 1px solid rgba(26, 30, 58, 0.06);
  }

  .upcoming__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .upcoming__heading-col {
    padding-top: 0.4rem;
  }

  .upcoming__heading {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .upcoming__sub {
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin: 0.15rem 0 0;
    letter-spacing: 0.02em;
  }

  .upcoming__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .upcoming__item { margin: 0; }

  .upcoming__link {
    display: block;
    padding: 0.7rem 0.85rem;
    background: #fff;
    border: 1px solid rgba(26, 30, 58, 0.1);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-navy);
    transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
    height: 100%;
  }

  .upcoming__link:hover {
    border-color: var(--color-blue);
    box-shadow: 0 2px 8px rgba(26, 30, 58, 0.08);
    transform: translateY(-1px);
  }

  .upcoming__date {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-red);
    margin-bottom: 0.35rem;
  }

  .upcoming__title {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.4rem;
    /* Clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .upcoming__meta {
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .upcoming__rsvp {
    color: var(--color-blue);
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .upcoming {
      padding: 1rem 1rem 1.1rem;
    }
    .upcoming__inner {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .upcoming__heading-col {
      padding-top: 0;
    }
    .upcoming__heading {
      font-size: 0.95rem;
    }
    .upcoming__sub {
      display: inline;
      margin-left: 0.4rem;
    }
    .upcoming__list {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .upcoming__link {
      padding: 0.6rem 0.75rem;
    }
    .upcoming__title {
      font-size: 0.8rem;
      -webkit-line-clamp: 2;
    }
  }
</style>
