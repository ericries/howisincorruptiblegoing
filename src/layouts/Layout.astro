---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tracking the momentum of Eric Ries's forthcoming book Incorruptible — events, endorsements, reviews, and more." />
    <meta name="theme-color" content="#1a1e3a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="How Is Incorruptible Going?" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
    <script>
      // Strip the hash from the URL when the user scrolls to the very
      // top — keeps a clean URL once they've left the deep-linked entry.
      (() => {
        let ticking = false;
        const maybeClearHash = () => {
          ticking = false;
          if (window.scrollY <= 4 && location.hash) {
            history.replaceState(null, '', location.pathname + location.search);
          }
        };
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(maybeClearHash);
            ticking = true;
          }
        }, { passive: true });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
