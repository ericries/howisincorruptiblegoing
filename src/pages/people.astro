---
import Layout from '../layouts/Layout.astro';
import PageNav from '../components/PageNav.astro';
import { loadEntries } from '../lib/entries';
import * as path from 'path';

const entries = loadEntries(path.join(process.cwd(), 'content', 'entries'));

// Aggregate by attribution — only entries with a real named attribution
// and one of the "who said something" types.
const RELEVANT = new Set(['endorsement', 'review', 'media', 'podcast']);

type PersonAgg = {
  key: string;
  name: string;
  title: string;
  image: string | null;
  count: number;
  latestDate: string;
  entryIds: string[];
};

const byKey = new Map<string, PersonAgg>();
for (const e of entries) {
  if (!RELEVANT.has(e.type)) continue;
  const name = (e.attribution || '').trim();
  if (!name) continue;
  // Skip Eric's own posts and generic aggregators
  if (name.startsWith('Eric Ries')) continue;
  const key = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const existing = byKey.get(key);
  if (existing) {
    existing.count += 1;
    if (e.date > existing.latestDate) existing.latestDate = e.date;
    if (!existing.image && e.attribution_image) existing.image = e.attribution_image;
    existing.entryIds.push(e.id);
  } else {
    byKey.set(key, {
      key,
      name,
      title: e.attribution_title || '',
      image: e.attribution_image || null,
      count: 1,
      latestDate: e.date,
      entryIds: [e.id],
    });
  }
}

// Split: multi-entry people ("recurring voices") + everyone else
const all = Array.from(byKey.values()).sort((a, b) => b.count - a.count || b.latestDate.localeCompare(a.latestDate));
const recurring = all.filter(p => p.count >= 2);
const everyone = all.filter(p => p.count === 1).sort((a, b) => b.latestDate.localeCompare(a.latestDate));
---

<Layout title="People · How Is Incorruptible Going?" description="Everyone who has publicly talked about Incorruptible — endorsers, reviewers, podcast hosts, and media.">
  <main class="page">
    <header class="page__masthead">
      <a class="page__home" href="/">← How Is Incorruptible Going?</a>
      <PageNav active="people" />
    </header>

    <div class="page__hero">
      <h1 class="page__title">People</h1>
      <p class="page__lede">
        Everyone who has publicly talked about the book.
        <span class="page__count">{all.length} voices · {recurring.length} recurring</span>
      </p>
    </div>

    {recurring.length > 0 && (
      <section class="page__section">
        <h2 class="page__section-title page__section-title--red">Recurring voices</h2>
        <ul class="people-grid">
          {recurring.map(p => (
            <li class="person-card person-card--recurring">
              <a href={`/e/${p.entryIds[0]}/`} class="person-card__link">
                <div class="person-card__avatar">
                  {p.image ? (
                    <img src={p.image} alt={p.name} loading="lazy" />
                  ) : (
                    <span class="person-card__initials">{p.name.split(/\s+/).slice(0, 2).map(w => w[0] || '').join('').toUpperCase()}</span>
                  )}
                </div>
                <div class="person-card__body">
                  <h3 class="person-card__name">{p.name}</h3>
                  {p.title && <p class="person-card__title">{p.title}</p>}
                  <span class="person-card__count">{p.count} entries · latest {new Date(p.latestDate + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="page__section">
      <h2 class="page__section-title">Everyone else</h2>
      <ul class="people-grid people-grid--compact">
        {everyone.map(p => (
          <li class="person-card">
            <a href={`/e/${p.entryIds[0]}/`} class="person-card__link">
              <div class="person-card__avatar">
                {p.image ? (
                  <img src={p.image} alt={p.name} loading="lazy" />
                ) : (
                  <span class="person-card__initials">{p.name.split(/\s+/).slice(0, 2).map(w => w[0] || '').join('').toUpperCase()}</span>
                )}
              </div>
              <div class="person-card__body">
                <h3 class="person-card__name">{p.name}</h3>
                {p.title && <p class="person-card__title">{p.title}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  .page { max-width: var(--max-width); margin: 0 auto; padding: 1rem 1.25rem 4rem; }
  .page__masthead { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0 1.5rem; flex-wrap: wrap; gap: 0.75rem; }
  .page__home { font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-navy); text-decoration: none; }
  .page__home:hover { color: var(--color-blue); }
  .page__nav { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .page__nav-link { font-family: var(--font-body); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1.5px solid var(--color-border); background: transparent; color: var(--color-text-muted); text-decoration: none; transition: all 0.15s ease; }
  .page__nav-link:hover { border-color: var(--color-navy); color: var(--color-navy); }
  .page__nav-link--active { background: var(--color-navy); border-color: var(--color-navy); color: var(--color-white); }

  .page__hero { padding: 1rem 0 2rem; border-bottom: 1px solid var(--color-border); margin-bottom: 2rem; }
  .page__title { font-family: var(--font-title); font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: 0.02em; color: var(--color-navy); margin-bottom: 0.5rem; }
  .page__lede { font-family: var(--font-body); color: var(--color-text-light); display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
  .page__count { font-size: 0.8rem; color: var(--color-text-muted); font-weight: 600; }

  .page__section { margin-bottom: 3rem; }
  .page__section-title { font-family: var(--font-title); font-size: 0.85rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-navy); padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-navy); margin-bottom: 1rem; }
  .page__section-title--red { color: var(--color-red); border-bottom-color: var(--color-red); }

  .people-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
  }
  .people-grid--compact {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.5rem;
  }
  .person-card {
    background: var(--color-card);
    border-radius: 8px;
    box-shadow: 0 1px 3px var(--color-shadow);
    padding: 0.9rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .person-card:hover { box-shadow: 0 4px 12px var(--color-shadow-lg); transform: translateY(-1px); }
  .person-card__link { display: flex; gap: 0.75rem; align-items: flex-start; text-decoration: none; color: inherit; width: 100%; }
  .person-card__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .person-card__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .person-card__body { flex: 1; min-width: 0; }
  .person-card__name {
    font-family: var(--font-title);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 0.15rem;
    line-height: 1.3;
  }
  .person-card__title {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.35;
    margin: 0 0 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .person-card__links {
    list-style: none;
    padding: 0;
    margin: 0.35rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .person-card__entry {
    font-size: 0.65rem;
    padding: 0.15rem 0.4rem;
    background: var(--color-gray-bg);
    border-radius: 4px;
    color: var(--color-text-light);
    font-family: monospace;
    text-decoration: none;
  }
  .person-card__entry:hover { background: var(--color-navy); color: var(--color-white); }
  .person-card__count {
    display: inline-block;
    font-size: 0.68rem;
    color: var(--color-red);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .people-grid, .people-grid--compact { grid-template-columns: 1fr; }
  }
</style>
