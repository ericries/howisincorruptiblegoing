---
import Layout from '../../layouts/Layout.astro';
import { loadEntries, partitionReactions } from '../../lib/entries';
import ShareButton from '../../components/ShareButton.astro';
import * as path from 'path';
import type { TimelineEntry } from '../../lib/schema';

export async function getStaticPaths() {
  const entriesDir = path.join(process.cwd(), 'content', 'entries');
  const allEntries = loadEntries(entriesDir);
  const { reactionsByParent } = partitionReactions(allEntries);
  return allEntries.map((e) => ({
    params: { id: e.id },
    props: {
      entry: e,
      reactions: reactionsByParent.get(e.id) ?? [],
    },
  }));
}

const { entry, reactions } = Astro.props as { entry: TimelineEntry; reactions: TimelineEntry[] };
const ogImage = entry.image || '/images/og-cover.png';
const canonical = `https://howisincorruptiblegoing.com/e/${entry.id}/`;
const timelineUrl = `https://howisincorruptiblegoing.com/#${entry.id}`;
// Strip wrapping quotes from titles like "'pull quote'" (the whole title is a quote).
// Don't touch titles where quotes appear inside (e.g. `Person — 'quote'`).
const cleanTitle = /^['"“‘].*['"”’]$/.test(entry.title)
  ? entry.title.replace(/^['"“‘]|['"”’]$/g, '')
  : entry.title;

const extraSources = (entry.source_urls || []) as Array<{ url: string; label: string }>;
---

<Layout
  title={`${cleanTitle} · How Is Incorruptible Going?`}
  description={entry.summary}
  ogImage={ogImage}
  canonical={canonical}
  ogType="article"
>
  <main class="permalink">
    <header class="permalink__masthead">
      <a class="permalink__home" href="/">← How Is Incorruptible Going?</a>
    </header>

    <article class="permalink__card">
      {entry.image && (
        <img class="permalink__hero" src={entry.image} alt={cleanTitle} />
      )}
      <div class="permalink__body">
        <h1 class="permalink__title">{cleanTitle}</h1>
        {entry.summary && <p class="permalink__summary">{entry.summary}</p>}
        {entry.blockquote && (
          <blockquote class="permalink__quote">
            “{entry.blockquote}”
            {entry.blockquote_source && (
              <cite class="permalink__cite">— {entry.blockquote_source}</cite>
            )}
          </blockquote>
        )}
        <div class="permalink__actions">
          <ShareButton
            url={canonical}
            title={cleanTitle}
            text={entry.summary || cleanTitle}
            cardSrc={entry.image || undefined}
          />
          <a class="permalink__timeline-link" href={timelineUrl}>Open in timeline ↗</a>
          {entry.source_url && (
            <a class="permalink__source-link" href={entry.source_url} target="_blank" rel="noopener">Original source ↗</a>
          )}
        </div>
      </div>
    </article>

    {extraSources.length > 0 && (
      <section class="permalink__extras">
        <h2 class="permalink__extras-title">Additional coverage</h2>
        <ul class="permalink__extras-list">
          {extraSources.map(s => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" class="permalink__extra-link">{s.label} ↗</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {reactions.length > 0 && (
      <section class="permalink__reactions">
        <h2 class="permalink__reactions-title">Reactions <span class="permalink__reactions-count">({reactions.length})</span></h2>
        <ul class="permalink__reactions-list">
          {reactions.map(r => (
            <li class="permalink__reaction">
              <a href={`/e/${r.id}/`} class="permalink__reaction-link">
                <div class="permalink__reaction-head">
                  {r.attribution && <span class="permalink__reaction-who">{r.attribution}</span>}
                  {r.attribution_title && <span class="permalink__reaction-title">{r.attribution_title}</span>}
                </div>
                {r.blockquote && (
                  <blockquote class="permalink__reaction-quote">&ldquo;{r.blockquote}&rdquo;</blockquote>
                )}
                {!r.blockquote && r.summary && (
                  <p class="permalink__reaction-summary">{r.summary}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>

<style>
  .permalink {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
  }
  .permalink__masthead {
    margin-bottom: 1.5rem;
  }
  .permalink__home {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .permalink__home:hover { color: var(--color-blue); }

  .permalink__card {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(26, 30, 58, 0.07);
    border: 1px solid rgba(26, 30, 58, 0.05);
  }
  .permalink__hero {
    display: block;
    width: 100%;
    height: auto;
  }
  .permalink__body {
    padding: 1.75rem 2rem 2rem;
  }
  .permalink__title {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1.25;
    color: var(--color-navy);
    margin-bottom: 0.85rem;
    font-weight: 600;
  }
  .permalink__summary {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }
  .permalink__quote {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-text);
    border-left: 3px solid var(--color-blue);
    padding-left: 1.1rem;
    font-style: italic;
    margin-bottom: 1.5rem;
  }
  .permalink__cite {
    display: block;
    margin-top: 0.6rem;
    font-style: normal;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }
  .permalink__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(26, 30, 58, 0.06);
    margin-top: 1rem;
  }
  .permalink__timeline-link,
  .permalink__source-link {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .permalink__timeline-link:hover,
  .permalink__source-link:hover { color: var(--color-blue); }

  /* ── Additional coverage + Reactions ── */
  .permalink__extras,
  .permalink__reactions {
    margin-top: 2rem;
  }
  .permalink__extras-title,
  .permalink__reactions-title {
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-navy);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-navy);
    margin-bottom: 1rem;
  }
  .permalink__reactions-count { font-size: 0.75em; color: var(--color-text-muted); font-weight: 500; letter-spacing: 0.05em; }

  .permalink__extras-list { list-style: none; padding: 0; margin: 0; }
  .permalink__extras-list li { padding: 0.5rem 0; border-bottom: 1px solid rgba(26, 30, 58, 0.05); }
  .permalink__extras-list li:last-child { border-bottom: none; }
  .permalink__extra-link {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--color-navy);
    text-decoration: none;
    line-height: 1.4;
    display: block;
  }
  .permalink__extra-link:hover { color: var(--color-blue); }

  .permalink__reactions-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .permalink__reaction {
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 1px 3px rgba(26, 30, 58, 0.07);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .permalink__reaction:hover { box-shadow: 0 4px 12px rgba(26, 30, 58, 0.13); transform: translateY(-1px); }
  .permalink__reaction-link { display: block; padding: 1rem 1.25rem; text-decoration: none; color: inherit; }
  .permalink__reaction-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .permalink__reaction-who {
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 0.95rem;
  }
  .permalink__reaction-title {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.35;
  }
  .permalink__reaction-quote {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-text);
    border-left: 2px solid var(--color-blue);
    padding-left: 0.75rem;
    margin: 0;
    line-height: 1.5;
    font-size: 0.98rem;
  }
  .permalink__reaction-summary {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .permalink { padding: 1rem 0.75rem 3rem; }
    .permalink__body { padding: 1.25rem 1.25rem 1.5rem; }
    .permalink__title { font-size: 1.4rem; }
  }
</style>
