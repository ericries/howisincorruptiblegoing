---
import Layout from '../layouts/Layout.astro';
import PageNav from '../components/PageNav.astro';
import { loadEntries } from '../lib/entries';
import * as path from 'path';

const entries = loadEntries(path.join(process.cwd(), 'content', 'entries'));
const today = new Date().toISOString().slice(0, 10);

const events = entries.filter(e => e.type === 'event');
const upcoming = events.filter(e => e.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const past = events.filter(e => e.date < today).sort((a, b) => b.date.localeCompare(a.date));

function fmtDate(iso: string) {
  return new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {
    weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC'
  });
}

function city(e: (typeof events)[number]): string | null {
  const meta = e.type_metadata as Record<string, unknown> | undefined;
  return typeof meta?.city === 'string' ? meta.city : null;
}
---

<Layout title="Events · How Is Incorruptible Going?" description="Book tour stops, panels, podcasts, and fireside chats with Eric Ries.">
  <main class="page">
    <header class="page__masthead">
      <a class="page__home" href="/">← How Is Incorruptible Going?</a>
      <PageNav active="events" />
    </header>

    <div class="page__hero">
      <h1 class="page__title">Events</h1>
      <p class="page__lede">
        Book tour stops, keynotes, and fireside chats.
        <span class="page__count">{upcoming.length} upcoming · {past.length} past</span>
      </p>
    </div>

    {upcoming.length > 0 && (
      <section class="page__section">
        <h2 class="page__section-title page__section-title--red">Upcoming</h2>
        <ul class="event-list">
          {upcoming.map(e => (
            <li class="event-row">
              <a class="event-row__link" href={`/e/${e.id}/`}>
                <div class="event-row__when">
                  <span class="event-row__date">{fmtDate(e.date)}</span>
                  {city(e) && <span class="event-row__city">{city(e)}</span>}
                </div>
                <div class="event-row__what">
                  <h3 class="event-row__title">{e.title}</h3>
                  {e.summary && <p class="event-row__summary">{e.summary}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {past.length > 0 && (
      <section class="page__section">
        <h2 class="page__section-title">Past</h2>
        <ul class="event-list">
          {past.map(e => (
            <li class="event-row event-row--past">
              <a class="event-row__link" href={`/e/${e.id}/`}>
                <div class="event-row__when">
                  <span class="event-row__date">{fmtDate(e.date)}</span>
                  {city(e) && <span class="event-row__city">{city(e)}</span>}
                </div>
                <div class="event-row__what">
                  <h3 class="event-row__title">{e.title}</h3>
                  {e.summary && <p class="event-row__summary">{e.summary}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.25rem 4rem;
  }
  .page__masthead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0 1.5rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .page__home {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-navy);
    text-decoration: none;
  }
  .page__home:hover { color: var(--color-blue); }
  .page__nav { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .page__nav-link {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .page__nav-link:hover { border-color: var(--color-navy); color: var(--color-navy); }
  .page__nav-link--active {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-white);
  }

  .page__hero {
    padding: 1rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }
  .page__title {
    font-family: var(--font-title);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }
  .page__lede {
    font-family: var(--font-body);
    color: var(--color-text-light);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .page__count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .page__section { margin-bottom: 3rem; }
  .page__section-title {
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-navy);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-navy);
    margin-bottom: 1rem;
  }
  .page__section-title--red { color: var(--color-red); border-bottom-color: var(--color-red); }

  .event-list { list-style: none; padding: 0; margin: 0; }
  .event-row {
    background: var(--color-card);
    border-radius: 8px;
    box-shadow: 0 1px 3px var(--color-shadow);
    margin-bottom: 0.6rem;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .event-row:hover { box-shadow: 0 4px 12px var(--color-shadow-lg); transform: translateY(-1px); }
  .event-row--past { opacity: 0.78; }

  .event-row__link {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    align-items: baseline;
  }
  .event-row__when { display: flex; flex-direction: column; gap: 0.15rem; }
  .event-row__date {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-red);
    letter-spacing: 0.02em;
  }
  .event-row__city {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .event-row__title {
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 0.35rem;
    line-height: 1.35;
  }
  .event-row__summary {
    font-size: 0.88rem;
    color: var(--color-text-light);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .event-row__link { grid-template-columns: 1fr; gap: 0.35rem; padding: 0.9rem 1rem; }
    .event-row__when { flex-direction: row; gap: 0.6rem; align-items: baseline; }
  }
</style>
