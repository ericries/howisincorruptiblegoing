---
import Layout from '../layouts/Layout.astro';
import { loadEntries } from '../lib/entries';
import * as fs from 'fs';
import * as path from 'path';

const entries = loadEntries(path.join(process.cwd(), 'content', 'entries'));

// Reader photos: /public/images/readers/<slug>.<ext>
// For each photo, try to find a matching entry by slug (id contains slug)
// so clicking a face jumps to the story.
const readersDir = path.join(process.cwd(), 'public', 'images', 'readers');
const readerFiles = fs.existsSync(readersDir)
  ? fs.readdirSync(readersDir).filter(f => /\.(jpe?g|png|webp)$/i.test(f))
  : [];

type Reader = {
  file: string;
  slug: string;
  displayName: string;
  matchedEntryId: string | null;
};

const readers: Reader[] = readerFiles.map(file => {
  const slug = file.replace(/\.(jpe?g|png|webp)$/i, '');
  const displayName = slug.split('-').map(w => w[0].toUpperCase() + w.slice(1)).join(' ');
  const matched = entries.find(e => e.id.includes(slug));
  return {
    file: `/images/readers/${file}`,
    slug,
    displayName,
    matchedEntryId: matched?.id ?? null,
  };
});

readers.sort((a, b) => a.displayName.localeCompare(b.displayName));
---

<Layout title="Readers · How Is Incorruptible Going?" description="Photos of readers holding, reading, and living with the book.">
  <main class="page">
    <header class="page__masthead">
      <a class="page__home" href="/">← How Is Incorruptible Going?</a>
      <nav class="page__nav">
        <a href="/events" class="page__nav-link">Events</a>
        <a href="/people" class="page__nav-link">People</a>
        <a href="/readers" class="page__nav-link page__nav-link--active">Readers</a>
      </nav>
    </header>

    <div class="page__hero">
      <h1 class="page__title">Readers</h1>
      <p class="page__lede">
        The book in the world — held, read, taught, and lived with.
        <span class="page__count">{readers.length} faces</span>
      </p>
    </div>

    <section class="page__section">
      <ul class="reader-wall">
        {readers.map(r => {
          const inner = (
            <figure class="reader-tile">
              <img class="reader-tile__img" src={r.file} alt={r.displayName} loading="lazy" />
              <figcaption class="reader-tile__name">{r.displayName}</figcaption>
            </figure>
          );
          return (
            <li>
              {r.matchedEntryId ? (
                <a href={`/e/${r.matchedEntryId}/`} class="reader-tile__link">{inner}</a>
              ) : inner}
            </li>
          );
        })}
      </ul>
    </section>

    <p class="page__footnote">
      If you're reading Incorruptible and want to be on this wall,
      <a href="https://x.com/ericries" target="_blank" rel="noopener">post a photo and tag Eric on X or LinkedIn.</a>
    </p>
  </main>
</Layout>

<style>
  .page { max-width: var(--max-width); margin: 0 auto; padding: 1rem 1.25rem 4rem; }
  .page__masthead { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0 1.5rem; flex-wrap: wrap; gap: 0.75rem; }
  .page__home { font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-navy); text-decoration: none; }
  .page__home:hover { color: var(--color-blue); }
  .page__nav { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .page__nav-link { font-family: var(--font-body); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1.5px solid var(--color-border); background: transparent; color: var(--color-text-muted); text-decoration: none; transition: all 0.15s ease; }
  .page__nav-link:hover { border-color: var(--color-navy); color: var(--color-navy); }
  .page__nav-link--active { background: var(--color-navy); border-color: var(--color-navy); color: var(--color-white); }

  .page__hero { padding: 1rem 0 2rem; border-bottom: 1px solid var(--color-border); margin-bottom: 2rem; }
  .page__title { font-family: var(--font-title); font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: 0.02em; color: var(--color-navy); margin-bottom: 0.5rem; }
  .page__lede { font-family: var(--font-body); color: var(--color-text-light); display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
  .page__count { font-size: 0.8rem; color: var(--color-text-muted); font-weight: 600; }

  .page__section { margin-bottom: 3rem; }

  .reader-wall {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.75rem;
  }
  .reader-tile {
    margin: 0;
    background: var(--color-card);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 1px 3px var(--color-shadow);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .reader-tile__link { text-decoration: none; color: inherit; display: block; }
  .reader-tile__link:hover .reader-tile { box-shadow: 0 6px 18px var(--color-shadow-lg); transform: translateY(-2px); }
  .reader-tile__img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    background: var(--color-gray-bg);
  }
  .reader-tile__name {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-navy);
    padding: 0.5rem 0.7rem 0.6rem;
    text-align: center;
    line-height: 1.3;
  }

  .page__footnote {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-top: 2rem;
    padding: 1rem;
  }
  .page__footnote a { color: var(--color-blue); font-weight: 600; }

  @media (max-width: 640px) {
    .reader-wall { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.5rem; }
  }
</style>
