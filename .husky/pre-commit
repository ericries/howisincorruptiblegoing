#!/bin/sh
export PATH="/opt/homebrew/opt/node@23/bin:$PATH"

# Schema + injection validation (fast, no network)
npx tsx scripts/lint-entries.ts

# UI / component invariants (catch regressions like skinny poster cards
# or row-of-faces reordering before they ship). Fast — no network.
npx vitest run --reporter=dot
TEST_EXIT=$?
if [ $TEST_EXIT -ne 0 ]; then
  echo ""
  echo "⚠️  Vitest failed (see above)."
  echo "   Fix the regression or edit tests/ if the design intentionally changed."
  echo "   To skip this check: git commit --no-verify"
  exit 1
fi

# Quote verification for any NEW or MODIFIED entry files in this commit
CHANGED_ENTRIES=$(git diff --cached --name-only -- 'content/entries/*.json')
if [ -n "$CHANGED_ENTRIES" ]; then
  echo "Verifying quotes for changed entries..."
  npx tsx scripts/verify-quotes.ts
  VERIFY_EXIT=$?
  if [ $VERIFY_EXIT -ne 0 ]; then
    echo ""
    echo "⚠️  Quote verification found issues (see above)."
    echo "   Fix blockquotes to match source pages, or set verified: false."
    echo "   To skip this check: git commit --no-verify"
    exit 1
  fi
fi

# Postmortems must invest in prevention at every level they reached — a row per
# why, nothing reading "remember to". Added 2026-10-21 at Eric's direction:
# "always make proportional investments in prevention at each level."
# Only runs when a postmortem is actually in the commit.
CHANGED_PM=$(git diff --cached --name-only -- 'docs/postmortems/*.md')
if [ -n "$CHANGED_PM" ]; then
  echo "Checking postmortem prevention tables..."
  python3 scripts/postmortem-lint.py $CHANGED_PM
  PM_EXIT=$?
  if [ $PM_EXIT -ne 0 ]; then
    echo ""
    echo "⚠️  A postmortem is missing prevention at a level it reached."
    echo "   See docs/postmortems/TEMPLATE.md. 'declined' with a reason is a valid status."
    echo "   To skip this check: git commit --no-verify"
    exit 1
  fi
fi
