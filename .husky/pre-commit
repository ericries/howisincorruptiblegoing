#!/bin/sh
export PATH="/opt/homebrew/opt/node@23/bin:$PATH"

# Schema + injection validation (fast, no network)
npx tsx scripts/lint-entries.ts

# UI / component invariants (catch regressions like skinny poster cards
# or row-of-faces reordering before they ship). Fast — no network.
npx vitest run --reporter=dot
TEST_EXIT=$?
if [ $TEST_EXIT -ne 0 ]; then
  echo ""
  echo "⚠️  Vitest failed (see above)."
  echo "   Fix the regression or edit tests/ if the design intentionally changed."
  echo "   To skip this check: git commit --no-verify"
  exit 1
fi

# Quote verification for any NEW or MODIFIED entry files in this commit
# --diff-filter=d excludes DELETIONS. Without it a deleted entry reaches the
# checkers as a path that no longer exists, and verify-quotes.ts died on ENOENT
# and failed the whole hook. Found on 2026-11-02 merging a duplicate entry —
# the first entry deletion the repo had ever had.
CHANGED_ENTRIES=$(git diff --cached --name-only --diff-filter=d -- 'content/entries/*.json')
if [ -n "$CHANGED_ENTRIES" ]; then
  # Offline first: checks the blockquote against the source text the scanner
  # already captured. No network, instant, and it is the ONLY check that works
  # on LinkedIn and X — 62% of entries, which no anonymous fetch can read.
  # A LinkedIn URL is knowable from the raw archive: the activity id is
  # canonical, so a mismatch means the URL was typed rather than copied. Two in
  # two days (a tweet id with no digits, a Burka slug and id both invented).
  echo "Checking source URLs against the raw archive..."
  python3 scripts/check_source_urls.py $CHANGED_ENTRIES || exit 1

  echo "Checking quotes against captured source text..."
  python3 scripts/quote_integrity.py $CHANGED_ENTRIES
  QI_EXIT=$?
  if [ $QI_EXIT -ne 0 ]; then
    echo ""
    echo "⚠️  A blockquote does not match the source text we captured."
    echo "   PARTIAL means the opening is real and the rest is not — that is the"
    echo "   composited-quote signature, not a formatting nit. Re-read the capture"
    echo "   in data/archive/source-texts/ and copy the span exactly."
    echo "   To skip this check: git commit --no-verify"
    exit 1
  fi

  # A NEW entry must arrive with its evidence. 708 legacy entries have no
  # captured source text and nothing can ever verify them; that gap exists
  # because the capture was optional. Applies to added files only, so editing
  # a legacy entry is not blocked by its own history.
  ADDED_ENTRIES=$(git diff --cached --name-only --diff-filter=A -- 'content/entries/*.json')
  if [ -n "$ADDED_ENTRIES" ]; then
    python3 scripts/quote_integrity.py --require-capture --quiet $ADDED_ENTRIES
    CAP_EXIT=$?
    if [ $CAP_EXIT -ne 0 ]; then
      echo ""
      echo "⚠️  A new entry has a blockquote nothing can verify."
      echo "   To skip this check: git commit --no-verify"
      exit 1
    fi
  fi

  # AI-ese in summaries. Scoped to summaries THIS commit writes: 404 of 889
  # predate the rules, and failing on all of them would block every unrelated
  # edit to an old entry. New drift is blocked; the backlog stays visible via
  # `python3 scripts/summary_tics.py content/entries/*.json`. Eric, 2026-11-01:
  # "careful about AI-ese, this reads like LLM speak." See docs/DRAFTING.md.
  echo "Checking summaries for AI-ese..."
  python3 scripts/summary_tics.py --vs-head $CHANGED_ENTRIES
  TICS_EXIT=$?
  if [ $TICS_EXIT -ne 0 ]; then
    echo ""
    echo "⚠️  A summary reads like LLM speak. See docs/DRAFTING.md."
    echo "   The usual cause is a sentence that restates the blockquote printed"
    echo "   below it, or one that narrates the research instead of reporting it."
    echo "   To skip this check: git commit --no-verify"
    exit 1
  fi

  # A rewritten summary must not contain facts its sources don't. Catches a
  # subagent supplying the clarity it needs — a title, a company, a round
  # number — that nothing in the entry supports.
  echo "Checking rewritten summaries for invented detail..."
  python3 scripts/summary_drift.py $CHANGED_ENTRIES
  DRIFT_EXIT=$?
  if [ $DRIFT_EXIT -ne 0 ]; then
    echo ""
    echo "⚠️  A rewritten summary introduces detail no source carries."
    echo "   Check it against data/archive/source-texts/<id>.json, or cut it."
    echo "   To skip this check: git commit --no-verify"
    exit 1
  fi

  # Then the network check, for the changed entries only.
  echo "Verifying quotes against live source pages..."
  npx tsx scripts/verify-quotes.ts $CHANGED_ENTRIES
  VERIFY_EXIT=$?
  if [ $VERIFY_EXIT -ne 0 ]; then
    echo ""
    echo "⚠️  Quote verification found issues (see above)."
    echo "   Fix the blockquote so it matches the source page exactly."
    echo "   Do NOT set verified:false to silence this. That field used to make"
    echo "   this checker skip the entry, which is how 725 of 871 entries ended"
    echo "   up unverified and the check fell to 2.9% coverage while exiting 0."
    echo "   To skip this check: git commit --no-verify"
    exit 1
  fi
fi

# Postmortems must invest in prevention at every level they reached — a row per
# why, nothing reading "remember to". Added 2026-10-21 at Eric's direction:
# "always make proportional investments in prevention at each level."
# Only runs when a postmortem is actually in the commit.
CHANGED_PM=$(git diff --cached --name-only -- 'docs/postmortems/*.md')
if [ -n "$CHANGED_PM" ]; then
  echo "Checking postmortem prevention tables..."
  python3 scripts/postmortem-lint.py $CHANGED_PM
  PM_EXIT=$?
  if [ $PM_EXIT -ne 0 ]; then
    echo ""
    echo "⚠️  A postmortem is missing prevention at a level it reached."
    echo "   See docs/postmortems/TEMPLATE.md. 'declined' with a reason is a valid status."
    echo "   To skip this check: git commit --no-verify"
    exit 1
  fi
fi
